{
    "name": "brooz",
    "version": "0.2.0",
    "private": true,
    "description": "A desktop dashboard of small apps, built on Electron.",
    "bugs": {
        "url": "https://github.com/Niekes/brooz/issues"
    },
    "license": "BSD-3-Clause",
    "author": "Niekes (https://niekes.com)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Niekes/brooz.git"
    },
    "main": "dist/main/index.cjs",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && vp build && vp pack",
        "test": "vp test run",
        "test:watch": "vp test",
        "coverage": "vp test run --coverage",
        "coverage:badge": "node scripts/coverage-badge.mjs",
        "test:e2e": "playwright test",
        "package": "electron-builder --publish never",
        "lint": "vp fmt --check && vp lint && npm run lint:template && npm run lint:fallow",
        "lint:template": "node scripts/check-template.mjs",
        "lint:fallow": "fallow dead-code --ci --format ${FALLOW_FORMAT:-human} && fallow health --ci --coverage-gaps --min-score 98 --format ${FALLOW_FORMAT:-human} && fallow dupes --ci --format ${FALLOW_FORMAT:-human}",
        "hooks:install": "fallow hooks install --target git && fallow hooks install --target agent --agent claude && fallow hooks install --target agent --agent codex"
    },
    "dependencies": {
        "electron-updater": "^6.8.9"
    },
    "devDependencies": {
        "@electron/fuses": "^2.1.3",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@huggingface/transformers": "^4.3.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "5.0.5",
        "electron": "^45.0.0",
        "electron-builder": "^26.15.3",
        "fallow": "3.34.1",
        "jsdom": "^30.1.3",
        "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
        "open-jev": "^0.1.2",
        "playwright": "^1.64.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0",
        "vitest": "5.0.5"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vitest": "5.0.5"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0 || ^24.11.0 || >=26.0.0"
        }
    },
    "productName": "Brooz"
}
